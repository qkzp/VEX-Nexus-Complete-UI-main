// BoltCanvas relational core. The schema deliberately keeps mutable configuration,
// calculator, and AI payloads in JSON where product evolution is expected, while
// preserving relational ownership, permissions, and query paths.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum SystemRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ExperienceLevel {
  JUST_STARTING
  FIRST_SEASON
  ONE_TO_TWO_SEASONS
  THREE_PLUS_SEASONS
  MENTOR_COACH
}

enum ProgrammingLanguage {
  VEXCODE_PYTHON
  VEXCODE_CPP
  PROS_CPP
  OTHER
}

enum TeamPermissionRole {
  OWNER
  ADMIN
  TEAM_LEAD
  MEMBER
  VIEWER
}

enum TeamRoboticsRole {
  BUILDER
  PROGRAMMER
  DRIVER
  CAD
  NOTEBOOK
  SCOUT
  TEAM_LEAD
  MENTOR
}

enum VexProgram {
  V5RC
  VIQRC
  VURC
  VAIRC
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum Visibility {
  PRIVATE
  TEAM
  PUBLIC
  UNLISTED
}

enum RobotStatus {
  ACTIVE
  PROTOTYPE
  ARCHIVED
  RETIRED
}

enum CompetitionType {
  VRC
  VEXU
  VIQRC
  CUSTOM
}

enum DrivetrainType {
  TANK
  ARCADE
  HOLONOMIC
  X_DRIVE
  MECANUM
  CUSTOM
}

enum MotorCartridge {
  RPM_100
  RPM_200
  RPM_600
  CUSTOM
}

enum MotorPurpose {
  DRIVE
  INTAKE
  LIFT
  ARM
