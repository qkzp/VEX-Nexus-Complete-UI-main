enum PartCategory {
  MOTOR
  GEAR
  SPROCKET
  CHAIN
  WHEEL
  BEARING
  SHAFT
  STRUCTURAL
  FASTENER
  SENSOR
  ELECTRONICS
  PNEUMATICS
  OTHER
}

enum GuideDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum RuleType {
  ROBOT
  MATCH
  SKILLS
