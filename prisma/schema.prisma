  MECHANICAL_ADVANTAGE
  FLYWHEEL_SURFACE_VELOCITY
  CHAIN_LENGTH
  WHEEL_TRAVEL
  ENCODER_DISTANCE
  UNIT_CONVERSION
  CUSTOM
