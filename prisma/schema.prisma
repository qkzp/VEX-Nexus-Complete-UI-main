  ROTATION
  OPTICAL
  DISTANCE
  GPS
  VISION
  SONAR
  ENCODER
  LIMIT_SWITCH
  BUMPER
  DIGITAL_IN
  DIGITAL_OUT
  ANALOG_IN
  ADI_ENCODER
  CUSTOM
