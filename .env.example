# Copy to .env for Next.js and Prisma development. Set real secrets in your hosting dashboard.
POSTGRES_PRISMA_URL=postgresql://vexcoder:vexcoder_local@localhost:5432/vexcoder
POSTGRES_URL_NON_POOLING=postgresql://vexcoder:vexcoder_local@localhost:5432/vexcoder
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_TRUST_HOST=true
ALLOW_DEV_RESET=false
ENABLE_LOCAL_DEV_TOOLS=false
# Optional comma-separated LAN origins permitted by `next dev` only.
NEXT_ALLOWED_DEV_ORIGINS=

# Required for password reset delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Enables official event data; never expose this as a NEXT_PUBLIC variable.
VEX_EVENTS_API_TOKEN=
